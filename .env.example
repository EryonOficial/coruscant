# Habblaud — copie para `.env` e ajuste o que precisar:
#   cp .env.example .env
#
# O servidor (npm start / bun run start / npm run dev) e o Docker Compose leem este arquivo.
# Chaves já definidas no ambiente do shell/serviço têm prioridade sobre o `.env`.
# Deixe em branco ou comente (#) o que quiser no padrão do código.

# ---------------------------------------------------------------------------------------------
# Rede
# ---------------------------------------------------------------------------------------------
# Porta HTTP (padrão: 4747).
HABBLAUD_PORT=4747
# Interface no modo Node (padrão: 127.0.0.1). Fora do loopback, terminal/mensagens/permissões desligam.
HABBLAUD_HOST=127.0.0.1
# Só Docker: onde a porta é publicada no host (padrão: 127.0.0.1). Use 0.0.0.0 para a rede local.
HABBLAUD_BIND=127.0.0.1
# Nomes extras aceitos no Host/Origin (vírgula), além de localhost e IPs.
# HABBLAUD_ALLOWED_HOSTS=meu-mac.local,habblaud.localhost

# ---------------------------------------------------------------------------------------------
# Contas / pastas (opcional — sem isso o Habblaud detecta sozinho)
# ---------------------------------------------------------------------------------------------
# Pastas do Claude Code, separadas por vírgula (substitui a detecção).
# HABBLAUD_CLAUDE_DIRS=/home/voce/.claude
# Pastas do Codex (substitui ~/.codex* e CODEX_HOME).
# HABBLAUD_CODEX_DIRS=/home/voce/.codex
# Pastas do Cursor (substitui ~/.cursor* e CURSOR_HOME).
# HABBLAUD_CURSOR_DIRS=/home/voce/.cursor
# JSON de metadados das contas (nome, letra, cor…); no Docker o docker:up também preenche.
# HABBLAUD_ACCOUNTS=

# ---------------------------------------------------------------------------------------------
# Fontes de agentes
# ---------------------------------------------------------------------------------------------
# 0 desliga o Codex no escritório (padrão: ligado).
# HABBLAUD_CODEX=1
# 0 desliga o Cursor no escritório (padrão: ligado).
# HABBLAUD_CURSOR=1
# Binário do Codex para mensagens (padrão: codex no PATH).
# HABBLAUD_CODEX_BIN=codex
# Binário do Claude Code para PTY / Novo agente (padrão: claude no PATH).
# HABBLAUD_CLAUDE_BIN=claude

# ---------------------------------------------------------------------------------------------
# Dados locais
# ---------------------------------------------------------------------------------------------
# Estado do Habblaud (nomes, timeline, stats). Padrão: ~/.habblaud (Docker: /data).
# HABBLAUD_DATA_DIR=
# Uso capturado pelo mod/statusline. Padrão: ~/.habblaud/usage (Docker: /usage).
# HABBLAUD_USAGE_DIR=
# 0 desliga a gravação da linha do tempo do timelapse (padrão: ligado).
# HABBLAUD_TIMELINE=1

# ---------------------------------------------------------------------------------------------
# Recursos
# ---------------------------------------------------------------------------------------------
# 0 desliga terminal, permissões, mensagens e editor de personagem (padrão: ligado com bind local).
# HABBLAUD_TERMINAL=1
# 0 desliga só as mensagens pelo escritório (padrão: ligado com o terminal).
# HABBLAUD_MENSAGENS=1
# 1 liga o terminal interativo e o Novo agente (padrão: desligado). Leia o aviso de privacidade no README.
# HABBLAUD_PTY=0
# 1 liga o modo demonstração ao iniciar (padrão: desligado).
# HABBLAUD_DEMO=0
# 0 desliga a verificação de versão no GitHub (padrão: ligado).
# HABBLAUD_UPDATE_CHECK=1
# Idioma dos textos do servidor: pt-BR, en, es ou fr (padrão: idioma do sistema).
# HABBLAUD_LANG=pt-BR

# ---------------------------------------------------------------------------------------------
# Habblaud World (opcional)
# ---------------------------------------------------------------------------------------------
# 0 desliga rotas/interface do World (padrão: ligado; nada sai até criar conta).
# HABBLAUD_WORLD=1
# Servidor do mundo (só https:// ou wss://). Padrão: https://server.habblaud.com
# HABBLAUD_WORLD_URL=https://server.habblaud.com
# 1 aceita mundo local sem TLS (http://127.0.0.1 ou host.docker.internal).
# HABBLAUD_WORLD_DEV=0

# ---------------------------------------------------------------------------------------------
# Acesso remoto / celular (preenchido por `npm run remote:setup`)
# ---------------------------------------------------------------------------------------------
# HABBLAUD_REMOTE_USER=
# HABBLAUD_REMOTE_PASSWORD_HASH=
# HABBLAUD_REMOTE_ALLOW=permissions
# HABBLAUD_REMOTE_PORT=4748
# HABBLAUD_REMOTE_HOST=0.0.0.0
# HABBLAUD_REMOTE_NAME=habblaud
# HABBLAUD_REMOTE_INSECURE_HTTP=0
